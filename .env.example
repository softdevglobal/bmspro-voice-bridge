OPENAI_API_KEY=REPLACE_PRIVATELY_ON_SERVER
BMSPRO_MCP_URL=https://command-api.bmspros.com.au/api/ai/mcp/black/
BMSPRO_BRIDGE_SECRET=REPLACE_WITH_SHARED_BACKEND_BRIDGE_SECRET
BMSPRO_MAX_CONCURRENT_CALLS=4
# Optional direct Trade connection. Set URL and secret; DIDs are discovered from Trade's dashboard.
# BMSPRO_TRADE_MCP_URL=https://your-trade-host/api/ai/mcp
# BMSPRO_TRADE_BRIDGE_SECRET=REPLACE_WITH_SEPARATE_TRADE_SECRET
# Chosen onboarding pilot. Use [] to leave onboarding routing disabled.
BMSPRO_ONBOARDING_DIDS_JSON=["0359111410"]
# Required only when onboarding DIDs are configured; use a different secret.
BMSPRO_ONBOARDING_BRIDGE_SECRET=REPLACE_WITH_SEPARATE_ONBOARDING_SECRET
# Optional shadow-only ASR. Off by default; requires the test DID to be explicitly allowlisted.
# VoiceStudio receives a copy of caller audio. It never provides audio or controls bookings.
BMSPRO_VOICESTUDIO_SHADOW_ENABLED=false
BMSPRO_VOICESTUDIO_SHADOW_DIDS_JSON=[]
BMSPRO_VOICESTUDIO_SHADOW_URL=ws://127.0.0.1:3900/v1/audio/transcriptions/stream?pcm=1&sr=16000
# Copy the VoiceStudio container's OMNIVOICE_API_KEY into the bridge's protected .env when enabling shadow ASR.
BMSPRO_VOICESTUDIO_API_KEY=
# Keep transcript contents out of logs by default. Enable only during an authorized test call.
BMSPRO_VOICESTUDIO_SHADOW_LOG_TRANSCRIPTS=false
